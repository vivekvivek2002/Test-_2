# Django Core Configuration
SECRET_KEY=your-production-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL (SQLite default locally; PostgreSQL on Render)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# DATABASE_URL=postgres://aurauser:password@localhost:5432/auradb

# Cloudinary Storage (Optional in local dev; required in production for media persistence)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyza@mycloudname
